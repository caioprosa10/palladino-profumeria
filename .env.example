# Copie para .env e preencha com os seus valores.
# O .env real nunca deve ser versionado.

# Banco de dados (Prisma)
# Postgres. Local: postgresql://SEU_USUARIO@localhost:5432/palladino_dev
DATABASE_URL=

# Assinatura das sessões. Gere com: openssl rand -base64 48
# Mínimo de 32 caracteres. A aplicação não sobe sem essa variável.
JWT_SECRET=""

# Mercado Pago — https://www.mercadopago.com.br/developers/panel
MP_ACCESS_TOKEN=""
# Segredo do webhook (painel do MP > Webhooks). Obrigatório em produção.
MP_WEBHOOK_SECRET=""

# Melhor Envio — cálculo de frete
MELHOR_ENVIO_TOKEN=""
CEP_ORIGEM=""

# Google Gemini — usado pelo consultor virtual
GEMINI_API_KEY=""

# Usuário administrador criado pelo `prisma db seed`.
# Sem ADMIN_PASSWORD definida o seed falha de propósito.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Apenas para testar o build de produção localmente sobre http (ex.: pelo IP
# da rede). Em produção real, atrás de HTTPS, deixe ausente.
DISABLE_HTTPS_UPGRADE=

# Banco de testes. Sem isso, a suite usa
# postgresql://SEU_USUARIO@localhost:5432/palladino_test
TEST_DATABASE_URL=

# Cifragem de dados sensiveis em repouso (CPF, tokens de integracao, 2FA).
# Gere com: openssl rand -base64 32
# Trocar esta chave torna ilegiveis os dados ja cifrados.
ENCRYPTION_KEY=

# URL publica da aplicacao, usada nos links enviados por e-mail
# (redefinicao de senha). Ex.: https://palladinoprofumeria.com.br
APP_URL=

# SMTP para e-mails transacionais e redefinicao de senha.
# Sem isso o link de recuperacao nao e entregue.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# Cloudflare Turnstile (CAPTCHA). Toda a integracao fica desligada sem as
# duas chaves: o honeypot e o rate limit seguem como protecao.
# Chaves em https://dash.cloudflare.com > Turnstile
# A SITE_KEY e publica e vai para o navegador; a SECRET_KEY so no servidor.
# A SITE_KEY precisa existir no BUILD, porque afeta o CSP.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Publica a politica CSP estrita em modo Report-Only, em paralelo a atual.
# Nao bloqueia nada: apenas relata em /api/csp-report o que seria bloqueado.
# Precisa existir no BUILD, porque afeta cabecalhos.
CSP_REPORT_ONLY=

# Backup (scripts/backup.ts). O arquivo sai cifrado com ENCRYPTION_KEY.
BACKUP_DIR=
BACKUP_RETENCAO_DIAS=
