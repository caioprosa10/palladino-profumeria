# Copie para .env e preencha com os seus valores.
# O .env real nunca deve ser versionado.

# Banco de dados (Prisma)
DATABASE_URL="file:./dev.db"

# Assinatura das sessões. Gere com: openssl rand -base64 48
# Mínimo de 32 caracteres. A aplicação não sobe sem essa variável.
JWT_SECRET=""

# Mercado Pago — https://www.mercadopago.com.br/developers/panel
MP_ACCESS_TOKEN=""
# Segredo do webhook (painel do MP > Webhooks). Obrigatório em produção.
MP_WEBHOOK_SECRET=""

# Melhor Envio — cálculo de frete
MELHOR_ENVIO_TOKEN=""
CEP_ORIGEM=""

# Google Gemini — usado pelo consultor virtual
GEMINI_API_KEY=""

# Usuário administrador criado pelo `prisma db seed`.
# Sem ADMIN_PASSWORD definida o seed falha de propósito.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Apenas para testar o build de produção localmente sobre http (ex.: pelo IP
# da rede). Em produção real, atrás de HTTPS, deixe ausente.
DISABLE_HTTPS_UPGRADE=
